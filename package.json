{
  "name": "cr3-agentic-ai",
  "version": "0.3.0",
  "description": "Next-Gen Desktop Autonomous Agent with Multi-Step Reasoning, Tool Execution & Human-in-the-Loop Control.",
  "author": "CR3 Architect",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test dist/test/*.test.js",
    "dist": "npm run build && electron-builder --mac",
    "dist:dir": "npm run build && electron-builder --mac --dir"
  },
  "build": {
    "appId": "com.cr3.agentic-ai",
    "productName": "CR3-Agentic AI",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "build/icon.icns",
      "build/icon.png",
      "package.json"
    ]
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  }
}
